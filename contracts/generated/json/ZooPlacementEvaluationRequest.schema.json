{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZooPlacementEvaluationRequest",
  "type": "object",
  "required": [
    "kind",
    "location",
    "orientation"
  ],
  "properties": {
    "kind": {
      "type": "string"
    },
    "location": {
      "$ref": "#/definitions/MapLocation"
    },
    "orientation": {
      "$ref": "#/definitions/GridOrientation"
    }
  },
  "definitions": {
    "GridOrientation": {
      "type": "string",
      "enum": [
        "North",
        "East",
        "South",
        "West"
      ]
    },
    "MapLocation": {
      "type": "object",
      "required": [
        "elevation",
        "x",
        "y"
      ],
      "properties": {
        "elevation": {
          "type": "integer",
          "format": "int32"
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      }
    }
  }
}