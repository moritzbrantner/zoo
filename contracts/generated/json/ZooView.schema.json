{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZooView",
  "type": "object",
  "required": [
    "alerts",
    "animal_species",
    "areas",
    "available_tech_nodes",
    "buildings",
    "entities",
    "fences",
    "jobs",
    "now_seconds",
    "objectives",
    "paths",
    "resources",
    "summary",
    "tech_nodes",
    "upgrades"
  ],
  "properties": {
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AlertView"
      }
    },
    "animal_species": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AnimalSpeciesView"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AreaView"
      }
    },
    "available_tech_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/BuildingView"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EntityView"
      }
    },
    "fences": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FenceView"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/JobView"
      }
    },
    "now_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ObjectiveView"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PathView"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ResourceView"
      }
    },
    "summary": {
      "$ref": "#/definitions/ZooSummary"
    },
    "tech_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "AlertView": {
      "type": "object",
      "required": [
        "message",
        "severity"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    },
    "AnimalSpeciesCostView": {
      "type": "object",
      "required": [
        "amount",
        "label",
        "resource_id"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "label": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        }
      }
    },
    "AnimalSpeciesView": {
      "type": "object",
      "required": [
        "animal_area_kind",
        "appeal",
        "fence_kind",
        "kind",
        "label",
        "min_fence_count",
        "min_level",
        "placed_count",
        "purchase_cost",
        "required_visitors",
        "unlocked"
      ],
      "properties": {
        "animal_area_kind": {
          "type": "string"
        },
        "appeal": {
          "type": "integer",
          "format": "int64"
        },
        "fence_kind": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "min_fence_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "min_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "placed_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "purchase_cost": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimalSpeciesCostView"
          }
        },
        "required_visitors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "unlocked": {
          "type": "boolean"
        }
      }
    },
    "AreaView": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "tiles"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapLocation"
          }
        }
      }
    },
    "BuildingView": {
      "type": "object",
      "required": [
        "assigned_workers",
        "height",
        "id",
        "inventory",
        "kind",
        "label",
        "level",
        "location",
        "manned",
        "production",
        "required_workers",
        "stats",
        "status"
      ],
      "properties": {
        "assigned_workers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceView"
          }
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "location": {
          "$ref": "#/definitions/MapLocation"
        },
        "manned": {
          "type": "boolean"
        },
        "production": {
          "type": "string"
        },
        "required_workers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "stats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int64"
          }
        },
        "status": {
          "type": "string"
        }
      }
    },
    "EntityBlueprintRef": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Unit"
          ],
          "properties": {
            "Unit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Npc"
          ],
          "properties": {
            "Npc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "EntityView": {
      "type": "object",
      "required": [
        "blueprint",
        "id",
        "kind",
        "label",
        "location",
        "stats"
      ],
      "properties": {
        "assigned_building": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "assigned_job": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "blueprint": {
          "$ref": "#/definitions/EntityBlueprintRef"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/MapLocation"
        },
        "stats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "FenceView": {
      "type": "object",
      "required": [
        "end",
        "height",
        "id",
        "kind",
        "start"
      ],
      "properties": {
        "end": {
          "$ref": "#/definitions/MapLocation"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/MapLocation"
        }
      }
    },
    "JobView": {
      "type": "object",
      "required": [
        "assigned_entities",
        "completes_at_seconds",
        "id",
        "kind"
      ],
      "properties": {
        "assigned_entities": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "completes_at_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "MapLocation": {
      "type": "object",
      "required": [
        "elevation",
        "x",
        "y"
      ],
      "properties": {
        "elevation": {
          "type": "integer",
          "format": "int32"
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ObjectiveView": {
      "type": "object",
      "required": [
        "complete",
        "current",
        "id",
        "label",
        "target"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "current": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "PathView": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "waypoints"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapLocation"
          }
        }
      }
    },
    "ResourceView": {
      "type": "object",
      "required": [
        "amount",
        "id",
        "label"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "ZooSummary": {
      "type": "object",
      "required": [
        "active_habitats",
        "animal_appeal",
        "animal_count",
        "average_welfare",
        "critical",
        "current_visitors",
        "customer_demand_percent",
        "customer_willingness",
        "entry_fee",
        "expected_customers_per_minute",
        "guest_departures_last_tick",
        "reputation_level",
        "tracked_guests",
        "won"
      ],
      "properties": {
        "active_habitats": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "animal_appeal": {
          "type": "integer",
          "format": "int64"
        },
        "animal_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "average_welfare": {
          "type": "integer",
          "format": "int64"
        },
        "critical": {
          "type": "boolean"
        },
        "current_visitors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "customer_demand_percent": {
          "type": "integer",
          "format": "int64"
        },
        "customer_willingness": {
          "type": "integer",
          "format": "int64"
        },
        "entry_fee": {
          "type": "integer",
          "format": "int64"
        },
        "expected_customers_per_minute": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "guest_departures_last_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reputation_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "tracked_guests": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "won": {
          "type": "boolean"
        }
      }
    }
  }
}