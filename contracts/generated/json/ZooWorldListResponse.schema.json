{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZooWorldListResponse",
  "type": "object",
  "required": [
    "worlds"
  ],
  "properties": {
    "worlds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ZooWorldListItem"
      }
    }
  },
  "definitions": {
    "ZooWorldListItem": {
      "type": "object",
      "required": [
        "version",
        "world_id"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "world_id": {
          "type": "string"
        }
      }
    }
  }
}