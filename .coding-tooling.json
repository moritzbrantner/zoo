{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "test:unit"],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:e2e:smoke",
      "test:accessibility",
      "benchmark:smoke"
    ],
    "integration": ["test:integration"],
    "e2e": ["test:e2e:smoke", "test:accessibility"],
    "performance": ["benchmark:smoke"]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": [
    "test:integration",
    "test:e2e:smoke",
    "test:accessibility",
    "benchmark:smoke"
  ],
  "capabilityCommands": {
    "@zoo/web": {
      "format:check": ["bun", "run", "format:check"],
      "lint": ["bun", "run", "lint"],
      "typecheck": ["bun", "run", "typecheck"],
      "build": ["bun", "run", "build"]
    }
  }
}
